38489>>>                // If from child, this is a probably a parent lookup from a Zoom
38489>>>                Case Break
38490>>>
38490>>>            Case (NavigateData.eNavigateType = nfFromMain)
38493>>>                // If from main, this is a probably a main-file lookup from a Zoom
38493>>>                WebSet pbRender of oDetailButton to False
38494>>>                Case Break
38495>>>
38495>>>            Case Else
38495>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38495>>>
38495>>>        Case End
38495>>>
38495>>>    End_Procedure
