38947>>>        WebSet pbRender of oSaveBtn to False
38948>>>        WebSet pbRender of oCancelChangesBtn to False
38949>>>        WebSet pbRender of oDeleteBtn to False
38950>>>
38950>>>        If (NavigateData.bReadOnly) Begin
38952>>>            WebSet pbRender of oEditBtn to True
38953>>>        End
38953>>>>
38953>>>        Else Begin
38954>>>            WebSet pbRender of oSaveBtn to True
38955>>>            WebSet pbRender of oCancelChangesBtn to True
38956>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38957>>>        End
38957>>>>
38957>>>    End_Procedure
